# Cloudflare serves these headers with the matching assets.
# Copied verbatim into dist/ by Vite; excluded from the service-worker
# precache list by scripts/generate-sw.mjs (it is config, not an asset).

# The service worker must never be served stale, or a device can keep an old
# build indefinitely: the browser only picks up a new build when it sees new
# bytes here. The worker itself precaches everything else, so this costs one
# small revalidation per visit.
/sw.js
  Cache-Control: no-cache

# Same reasoning for the pages that name the current hashed bundles: the home
# page, and the app shell the service worker answers navigations with. (Every
# other prerendered page already gets Cloudflare's default
# `max-age=0, must-revalidate`, which revalidates the same way.)
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# The app shell is an empty page outside the app's routes: keep it out of
# search results (PRD 21).
/app-shell
  Cache-Control: no-cache
  X-Robots-Tag: noindex
