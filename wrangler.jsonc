{
  // Static-asset Worker: the whole site is prebuilt into dist/ and served from
  // Cloudflare's edge. There is no server code — `main` is deliberately absent,
  // which keeps this a pure static deploy and costs nothing per request.
  //
  // Deploy with:  CLOUDFLARE_API_TOKEN=... npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "montessori-math",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./dist",
    // Every page is prerendered to its own file (scripts/prerender.mjs,
    // PRD 21): /lessons/golden-beads-intro is lessons/golden-beads-intro.html.
    // auto-trailing-slash (Cloudflare's default, stated here because the
    // layout depends on it) serves foo.html at /foo and redirects /foo/ and
    // /foo.html there.
    "html_handling": "auto-trailing-slash",
    // A path that matches no file is not a page: answer it with 404.html and
    // a real 404 status, so search engines don't index typos as pages.
    "not_found_handling": "404-page"
  },
  // The public domain (registered with Cloudflare Registrar). Custom Domains
  // create their own DNS records and certificates. Every deploy rewrites the
  // Worker's routes from this list, so a domain added only in the dashboard
  // would be dropped — this file is the source of truth.
  "routes": [
    { "pattern": "montessori-math.org", "custom_domain": true },
    { "pattern": "www.montessori-math.org", "custom_domain": true }
  ],
  // Declaring routes turns the workers.dev URL off by default; keep it so
  // existing links to montessori-math.eterps.workers.dev still work.
  "workers_dev": true
}
